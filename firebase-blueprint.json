  "firestore": {
    "/raport_validations/{validationId}": {
      "schema": "RaportVerification",
      "description": "Collection of digital report card validation tokens for authenticity verification"
    },
    "/subjects/{subjectId}": {
      "schema": "MataPelajaran",
      "description": "Collection of school curriculum subjects and teacher assignments"
    },
    "/users/{userId}": {
      "schema": "User",
      "description": "User accounts collection"
    },
    "/classes/{classId}": {
      "schema": "Kelas",
      "description": "School classes collection"
    },
    "/jurusan/{jurusanId}": {
      "schema": "Jurusan",
      "description": "Academic majors collection"
    },
    "/grades/{gradeId}": {
      "schema": "NilaiSiswa",
      "description": "Student grade records collection"
    },
    "/attendance/{recordId}": {
      "schema": "AbsensiRecord",
      "description": "Student attendance logs collection"
    },
    "/school_settings/{configId}": {
      "schema": "SchoolSettings",
      "description": "Global school settings and kop configurations"
    }
  }
